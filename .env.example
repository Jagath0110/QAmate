# ---------------------------------------------------------------------------
# QAmate — copy this file to .env and fill in what you have.
# The app runs with NONE of these set: it falls back to the seeded snapshot
# of the QA workbook. Add credentials when you want live data. There is no
# database — the app reads the sheet directly, cached in memory for ~60s.
# ---------------------------------------------------------------------------

# --- Google Sheets (optional until you want live data) ----------------------
# 1. Create a Google Cloud service account and enable the Sheets API.
# 2. Share the QA sheet with the service account e-mail as VIEWER (read-only).
# 3. Paste the whole service-account JSON here, base64-encoded, on ONE line.
#    macOS/Linux:  base64 -w0 key.json
#    Windows:      [Convert]::ToBase64String([IO.File]::ReadAllBytes("key.json"))
GOOGLE_SERVICE_ACCOUNT_KEY=

# The sheet id from its URL:
# https://docs.google.com/spreadsheets/d/<THIS PART>/edit
QA_SHEET_ID=

# Issues now live in an "Issues" tab of the same sheet — see README.md for
# its column layout. No separate credentials needed.

# --- Sync ------------------------------------------------------------------
# Shared secret the Apps Script webhook (and the cron hitting /api/sync/run)
# signs its calls with.
SYNC_WEBHOOK_SECRET=change-me
# Minutes after which the header pill turns amber, then red.
SYNC_STALE_WARN_MINUTES=15
SYNC_STALE_ERROR_MINUTES=60

# --- Client share links -----------------------------------------------------
# Secret used to sign read-only client tokens.
SHARE_TOKEN_SECRET=change-me-too
