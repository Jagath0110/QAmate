// QAmate — QA test case dashboard
// SQLite by default so the app runs with no external services.
// To move to Postgres: change provider to "postgresql" and point DATABASE_URL
// at your instance. No model changes are required.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// One row per test case in the QA workbook.
/// Natural key is (sheetTab, testCaseId) — scoping to the tab stops a future
/// duplicate TC-ID in another tab from silently overwriting a case.
model TestCase {
  id            String    @id @default(cuid())
  testCaseId    String
  sheetTab      String
  rowNumber     Int       @default(0)

  area          String
  module        String?
  scenario      String
  type          String?
  priority      String?
  platform      String?

  preconditions String?
  testData      String?
  steps         String?
  expected      String?
  actual        String?

  status        String    @default("Not Run")
  defectId      String?
  tester        String?
  executedAt    DateTime?
  comments      String?
  sourceLabel   String?
  whyManual     String?

  execution     String    @default("Manual") // Manual | Automated

  contentHash   String
  deletedAt     DateTime?
  firstSeenAt   DateTime  @default(now())
  lastSyncedAt  DateTime  @updatedAt

  revisions     TestCaseRevision[]

  @@unique([sheetTab, testCaseId])
  @@index([status])
  @@index([module])
  @@index([executedAt])
  @@index([deletedAt])
}

/// One row per detected change. Powers "recently updated" and the audit trail.
model TestCaseRevision {
  id           String   @id @default(cuid())
  testCaseRef  String
  testCase     TestCase @relation(fields: [testCaseRef], references: [id], onDelete: Cascade)
  testCaseId   String
  changedAt    DateTime @default(now())
  fromStatus   String?
  toStatus     String?
  changedField String   // JSON: { field: [before, after], ... }
  syncRunId    String?

  @@index([changedAt])
  @@index([testCaseRef])
}

/// One row per day. The ONLY source of trend data — a sheet cannot produce
/// history retroactively, which is the whole reason this table exists.
model QaSnapshot {
  id             String   @id @default(cuid())
  capturedOn     DateTime @unique
  total          Int
  inScope        Int
  passed         Int
  failed         Int
  blocked        Int
  retest         Int
  notRun         Int
  notApplicable  Int
  automatedCount Int
  openIssues     Int      @default(0)
  confirmedIssues Int     @default(0)
  healthScore    Float
  byModule       String   // JSON

  @@index([capturedOn])
}

/// Sync health log — drives the "Last synced" pill and the internal health page.
model SyncRun {
  id          String    @id @default(cuid())
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  trigger     String    // cron | webhook | manual | seed
  status      String    // success | partial | failed
  rowsRead    Int       @default(0)
  created     Int       @default(0)
  updated     Int       @default(0)
  unchanged   Int       @default(0)
  softDeleted Int       @default(0)
  warnings    String    @default("[]") // JSON array
  error       String?

  @@index([startedAt])
}

/// GitHub issues raised from failed test cases, and their QA lifecycle.
/// Stages: open | in_progress | resolved | retest_failed | retest_passed | confirmed
model Issue {
  id           String    @id @default(cuid())
  number       Int       @unique
  repo         String
  title        String
  body         String?
  url          String?

  testCaseIds  String    @default("[]") // JSON array of TC-IDs
  module       String?
  area         String?
  severity     String    @default("Medium")
  labels       String    @default("[]") // JSON array

  stage        String    @default("open")
  reporter     String?
  assignee     String?

  createdAt    DateTime
  closedAt     DateTime?
  closedBy     String?
  resolution   String?

  retestAt     DateTime?
  retestBy     String?
  retestResult String?   // Pass | Fail
  retestNote   String?

  confirmedAt  DateTime?
  confirmedBy  String?
  confirmNote  String?

  reopened     Int       @default(0)
  ghState      String?   // open | closed, straight from GitHub
  lastSyncedAt DateTime  @updatedAt

  @@index([stage])
  @@index([severity])
  @@index([module])
}
